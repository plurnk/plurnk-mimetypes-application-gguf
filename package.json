{
    "name": "@plurnk/plurnk-mimetypes-application-gguf",
    "version": "2.0.1",
    "description": "application/x-gguf (GGUF local-LLM model) mimetype handler for plurnk-service. Parses the metadata header (arch/quant/context/tokenizer) without loading weights. Hand-rolled, no parser dependency.",
    "type": "module",
    "license": "MIT",
    "publishConfig": {
        "access": "public"
    },
    "engines": {
        "node": ">=26"
    },
    "plurnk": {
        "kind": "mimetype",
        "binary": true,
        "handlers": [
            {
                "name": "application/x-gguf",
                "glyph": "🧠",
                "extensions": [
                    ".gguf"
                ],
                "revision": "1"
            }
        ]
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist/**/*",
        "README.md"
    ],
    "scripts": {
        "test:lint": "tsc --noEmit",
        "test:unit": "npm run build:dist && node --test --env-file=node_modules/@plurnk/plurnk-mimetypes/.env.defaults src/**/*.test.ts",
        "test": "npm run test:lint && npm run test:unit",
        "build:dist": "tsc -p tsconfig.build.json",
        "build": "npm run build:dist",
        "prepare": "npm run build && (git config core.hooksPath .githooks || true)",
        "prepublishOnly": "npm test"
    },
    "devDependencies": {
        "@types/node": "^26.0.0",
        "typescript": "^7.0.2",
        "@plurnk/plurnk-mimetypes": "^2.0.0 || ^3.0.0"
    },
    "peerDependencies": {
        "@plurnk/plurnk-mimetypes": "^2.0.0 || ^3.0.0"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/plurnk/plurnk-mimetypes-application-gguf.git"
    },
    "homepage": "https://github.com/plurnk/plurnk-mimetypes-application-gguf#readme"
}
